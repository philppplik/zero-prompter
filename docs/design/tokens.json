{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": { "name": "zero-teleprompter", "version": "1.0.0", "date": "2026-10-10", "contrastStandard": "WCAG 2.2" },
  "ui": {
    "$source": "tweakcn 'Minimal Neutral' (tweakcn.com/themes/cmho4nr9l000h04l1gu419ckw), oklch -> sRGB hex",
    "light": {
      "bg": "#FFFFFF", "surface": "#FDFDFD", "surfaceRaised": "#FFFFFF", "surfaceSunken": "#F5F5F5",
      "border": "#EEEEEE", "borderStrong": "#D4D4D4",
      "text": "#0A0A0A", "textMuted": "#737373", "textOnAccent": "#FAFAFA",
      "accent": "#171717", "accentHover": "#404040", "accentSubtle": "#EEEEEE",
      "focusRing": "#A3A3A3", "overlay": "rgba(10,10,10,0.28)",
      "cardFrom": "#FFFFFF", "cardTo": "#F4F4F5", "danger": "#E7000B"
    },
    "dark": {
      "bg": "#171717", "surface": "#0E0E0E", "surfaceRaised": "#1F1F1F", "surfaceSunken": "#262626",
      "border": "#262626", "borderStrong": "#404040",
      "text": "#FAFAFA", "textMuted": "#A3A3A3", "textOnAccent": "#171717",
      "accent": "#E5E5E5", "accentHover": "#FFFFFF", "accentSubtle": "#404040",
      "focusRing": "#737373", "overlay": "rgba(0,0,0,0.55)",
      "cardFrom": "#1F1F1F", "cardTo": "#121212", "danger": "#FF6467"
    }
  },
  "state": {
    "idle":      { "color": "#8A8F98", "shape": "circle-outline", "label": "Voice aus" },
    "listening": { "color": "#4CC2FF", "shape": "circle-pulse",   "label": "Hört zu" },
    "tracking":  { "color": "#3DD68C", "shape": "circle-filled",  "label": "Folgt" },
    "hold":      { "color": "#FFB224", "shape": "pause-bars",     "label": "Wartet" },
    "lost":      { "color": "#F2555A", "shape": "triangle",       "label": "Verloren" },
    "resync":    { "color": "#8E7BFF", "shape": "arc-rotate",     "label": "Springt" }
  },
  "prompter": {
    "studioDark":       { "bg": "#0E0F12", "text": "#F4F1EA", "readOpacity": 0.40, "marker": "#FFB224", "wordHighlight": "rgba(255,178,36,0.22)", "direction": "#8A8F98", "contrast": 16.99, "wcag": "AAA" },
    "broadcastClassic": { "bg": "#000000", "text": "#FFFFFF", "readOpacity": 0.40, "marker": "#FFE14D", "wordHighlight": "rgba(255,225,77,0.25)", "direction": "#9AA0A6", "contrast": 21.0, "wcag": "AAA" },
    "daylight":         { "bg": "#FAF8F3", "text": "#1A1A1A", "readOpacity": 0.45, "marker": "#C2410C", "wordHighlight": "rgba(194,65,12,0.14)", "direction": "#5C6370", "contrast": 16.40, "wcag": "AAA" },
    "highContrast":     { "bg": "#000000", "text": "#FFE14D", "readOpacity": 0.55, "marker": "#FFFFFF", "wordHighlight": "rgba(255,255,255,0.30)", "direction": "#FFFFFF", "contrast": 16.13, "wcag": "AAA" },
    "lowLight":         { "bg": "#120D08", "text": "#C9B79A", "readOpacity": 0.45, "marker": "#B5542C", "wordHighlight": "rgba(181,84,44,0.25)", "direction": "#7D6F5C", "contrast": 9.87, "wcag": "AAA" },
    "dyslexia":         { "bg": "#FDF6E3", "text": "#1F2A44", "readOpacity": 0.45, "marker": "#2563EB", "wordHighlight": "rgba(37,99,235,0.14)", "direction": "#5C6370", "contrast": 13.22, "wcag": "AAA", "letterSpacing": "0.04em", "wordSpacing": "0.16em", "lineHeight": 1.6 }
  },
  "type": {
    "fontUi": "'DM Sans Variable', 'DM Sans', ui-sans-serif, system-ui, sans-serif",
    "fontPrompter": "'Atkinson Hyperlegible Next', Inter, system-ui, sans-serif",
    "fontMono": "'Geist Mono Variable', 'Geist Mono', ui-monospace, monospace",
    "scale": {
      "caption": { "size": 11, "line": 16, "weight": 500 },
      "footnote": { "size": 12, "line": 16, "weight": 400 },
      "body":    { "size": 13, "line": 20, "weight": 400 },
      "bodyStrong": { "size": 13, "line": 20, "weight": 600 },
      "callout": { "size": 15, "line": 22, "weight": 500 },
      "title3":  { "size": 17, "line": 24, "weight": 600 },
      "title2":  { "size": 22, "line": 28, "weight": 600 },
      "title1":  { "size": 28, "line": 34, "weight": 700 },
      "display": { "size": 96, "line": 96, "weight": 700 }
    },
    "prompter": { "sizeMin": 24, "sizeDefault": 72, "sizeMax": 300, "lineHeight": 1.4, "measureCh": 32, "weight": 500 }
  },
  "space": { "0": 0, "1": 2, "2": 4, "3": 8, "4": 12, "5": 16, "6": 20, "7": 24, "8": 32, "9": 40, "10": 48, "11": 64 },
  "radius": { "xs": 4, "sm": 8, "md": 10, "lg": 16, "xl": 20, "card": 24, "pill": 999 },
  "elevation": {
    "0": "none",
    "1": "0 1px 3px 0 hsl(0 0% 0% / .10), 0 1px 2px -1px hsl(0 0% 0% / .10)",
    "2": "0 1px 3px 0 hsl(0 0% 0% / .10), 0 4px 6px -1px hsl(0 0% 0% / .10)",
    "3": "0 1px 3px 0 hsl(0 0% 0% / .10), 0 8px 10px -1px hsl(0 0% 0% / .10), 0 16px 40px -8px hsl(0 0% 0% / .16)",
    "4": "0 1px 3px 0 hsl(0 0% 0% / .12), 0 24px 64px -12px hsl(0 0% 0% / .30)"
  },
  "motion": {
    "duration": { "instant": 0, "fast": 120, "base": 200, "slow": 300, "panel": 260, "countdown": 1000, "resync": 300, "playEase": 600 },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "enter": "cubic-bezier(0, 0, 0, 1)",
      "exit": "cubic-bezier(0.3, 0, 1, 1)",
      "emphasized": "cubic-bezier(0.32, 0.72, 0, 1)",
      "scrollStartStop": "cubic-bezier(0.45, 0, 0.55, 1)",
      "spring": { "stiffness": 170, "damping": 26, "mass": 1 }
    },
    "reducedMotion": { "resync": 0, "pulse": "none", "countdown": "crossfade-only" }
  },
  "layout": { "sidebar": 240, "inspector": 300, "toolbar": 44, "transport": 56, "titlebar": 38, "focusLineDefault": 0.35, "minWindow": [960, 600] },
  "focus": { "ringWidth": 2, "ringOffset": 2 }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "zero-teleprompter",
  "version": "0.1.0",
  "identifier": "dev.zeroteleprompter.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "control",
        "title": "zero-teleprompter",
        "url": "index.html",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "dragDropEnabled": true
      },
      {
        "label": "talent",
        "title": "zero-teleprompter – Talent",
        "url": "talent.html",
        "width": 1024,
        "height": 640,
        "minWidth": 320,
        "minHeight": 200,
        "visible": false,
        "decorations": true,
        "backgroundColor": "#0E0F12",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Offline teleprompter with voice tracking",
    "longDescription": "Free, open-source teleprompter. Offline voice tracking (German/English), mirroring, multi-monitor output.",
    "copyright": "zero-teleprompter contributors – MIT OR Apache-2.0",
    "licenseFile": "../../../LICENSE-MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "entitlements.plist"
    },
    "linux": {
      "deb": { "depends": ["libasound2"] }
    }
  }
}
